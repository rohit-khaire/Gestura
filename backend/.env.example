# Copy to .env and fill in
PORT=5000
NODE_ENV=development
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Optional: comma-separated sites allowed to call this API from a browser
# (defaults to http://localhost:5173 in development, the Vercel site otherwise)
# CORS_ORIGIN=https://sign-detection.vercel.app,http://localhost:5173
